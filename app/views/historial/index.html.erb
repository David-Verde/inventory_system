<%# app/views/historial/index.html.erb %>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white" data-theme="title">Historial Global de Transferencias</h1>
  
  <%# Botón para exportar a Excel. Añadimos format: :xlsx a la URL %>
  <%= link_to "Exportar a Excel", historial_path(format: :xlsx), class: "inline-flex items-center px-4 py-2 bg-green-600 border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-green-700 active:bg-green-900 focus:outline-none focus:border-green-900 focus:ring ring-green-300 disabled:opacity-25 transition ease-in-out duration-150" %>
</div>

<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
    <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
      <tr>
        <th scope="col" class="px-6 py-3">Fecha y Hora</th>
        <th scope="col" class="px-6 py-3">Artículo (Marca y Modelo)</th>
        <th scope="col" class="px-6 py-3">Usuario Asignado</th>
        <th scope="col" class="px-6 py-3">ID de Artículo</th>
        <th scope="col" class="px-6 py-3">ID de Usuario</th>
      </tr>
    </thead>
    <tbody>
      <% @transferencias.each do |transferencia| %>
        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
          <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
            <%= l(transferencia.created_at, format: :long) %>
          </td>
          <td class="px-6 py-4">
            <%= link_to "#{transferencia.articulo.modelo.marca.nombre} #{transferencia.articulo.modelo.nombre}", transferencia.articulo, class: "font-medium text-blue-600 dark:text-blue-500 hover:underline" %>
          </td>
          <td class="px-6 py-4">
            <%= link_to transferencia.persona.nombre_completo, transferencia.persona, class: "font-medium text-blue-600 dark:text-blue-500 hover:underline" %>
          </td>
          <td class="px-6 py-4"><%= transferencia.articulo_id %></td>
          <td class="px-6 py-4"><%= transferencia.persona_id %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>